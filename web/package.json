{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run cesium:assets && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "cesium:assets": "mkdir -p public/cesium && cp -R node_modules/cesium/Build/Cesium/Workers public/cesium/ && cp -R node_modules/cesium/Build/Cesium/ThirdParty public/cesium/ && cp -R node_modules/cesium/Build/Cesium/Assets public/cesium/ && cp -R node_modules/cesium/Build/Cesium/Widgets public/cesium/",
    "postinstall": "npm run cesium:assets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cesium": "^1.147.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
