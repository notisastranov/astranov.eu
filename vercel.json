{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"},
        {"key": "Pragma", "value": "no-cache"},
        {"key": "X-Astranov-Build", "value": "4398"},
        {"key": "X-Astranov-Ship", "value": "4398-real"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"},
        {"key": "Pragma", "value": "no-cache"},
        {"key": "X-Astranov-Build", "value": "4398"},
        {"key": "X-Astranov-Ship", "value": "4398-real"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"},
        {"key": "Service-Worker-Allowed", "value": "/"}
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=604800, immutable"},
        {"key": "Access-Control-Allow-Origin", "value": "*"}
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"},
        {"key": "Access-Control-Allow-Origin", "value": "*"}
      ]
    }
  ],
  "redirects": [
    {"source": "/host", "destination": "/servernet", "permanent": false},
    {"source": "/host/", "destination": "/servernet", "permanent": false},
    {"source": "/hostnet", "destination": "/servernet", "permanent": false},
    {"source": "/hostnet/", "destination": "/servernet", "permanent": false}
  ],
  "rewrites": [
    {"source": "/", "has": [{"type": "host", "value": "datanet.astranov.eu"}], "destination": "/datanet/index.html"},
    {"source": "/index.html", "has": [{"type": "host", "value": "datanet.astranov.eu"}], "destination": "/datanet/index.html"},
    {"source": "/", "has": [{"type": "host", "value": "servernet.astranov.eu"}], "destination": "/servernet/index.html"},
    {"source": "/index.html", "has": [{"type": "host", "value": "servernet.astranov.eu"}], "destination": "/servernet/index.html"},
    {"source": "/", "has": [{"type": "host", "value": "spacenet.astranov.eu"}], "destination": "/index.html"},
    {"source": "/index.html", "has": [{"type": "host", "value": "spacenet.astranov.eu"}], "destination": "/index.html"},
    {"source": "/", "has": [{"type": "host", "value": "astranov.eu"}], "destination": "/index.html"},
    {"source": "/index.html", "has": [{"type": "host", "value": "astranov.eu"}], "destination": "/index.html"},
    {"source": "/", "has": [{"type": "host", "value": "www.astranov.eu"}], "destination": "/index.html"},
    {"source": "/index.html", "has": [{"type": "host", "value": "www.astranov.eu"}], "destination": "/index.html"},
    {"source": "/api/ai/pricing", "destination": "/api/ai"},
    {"source": "/api/paypal/config", "destination": "/api/paypal"},
    {"source": "/datanet", "destination": "/datanet/index.html"},
    {"source": "/datanet/", "destination": "/datanet/index.html"},
    {"source": "/servernet", "destination": "/servernet/index.html"},
    {"source": "/servernet/", "destination": "/servernet/index.html"},
    {"source": "/privacy", "destination": "/privacy.html"},
    {"source": "/terms", "destination": "/terms.html"},
    {"source": "/opt-in", "destination": "/opt-in.html"}
  ]
}
